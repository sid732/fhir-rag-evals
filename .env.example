# Copy to .env and fill in. .env is gitignored; never commit a real key.
ANTHROPIC_API_KEY=

# Without API credits: run every model call through the Claude Code CLI on a
# logged-in Claude subscription instead (docs/evals.md, "Running on a Claude
# subscription"). The CLAUDE_CONFIG_DIR of the login to use; unset uses the
# CLI's default login.
# FHIR_RAG_LLM_BACKEND=cli
# FHIR_RAG_CLAUDE_CONFIG_DIR=~/.claude

# Optional overrides (defaults in src/fhir_rag/config.py):
# FHIR_RAG_GENERATOR_MODEL=claude-opus-5-5
# FHIR_RAG_GENERATOR_EFFORT=medium
# FHIR_RAG_JUDGE_MODEL=claude-sonnet-5-5
# FHIR_RAG_TOP_K=10
# FHIR_RAG_RETRIEVAL_MODE=hybrid
# FHIR_RAG_SERIES_EXPANSION=3
# FHIR_RAG_PIN_SUMMARY=true
